<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Gestion des produits</title>
</head>
<body>
  <h1>Produits</h1>
   @include('admin/_nav')


  <a href="/admin/produits/nouveau">Ajouter un produit</a>

  <table border="1">
    <thead>
      <tr>
        <th>Nom</th>
        <th>Catégorie</th>
        <th>Prix</th>
        <th>Disponible</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      @each(produit in produits)
        <tr>
          <td>{{ produit.nom }}</td>
          <td>{{ produit.categorie.nom }}</td>
          <td>{{ produit.prix }} €</td>
          <td>{{ produit.disponible ? 'Oui' : 'Non' }}</td>
          <td>
            <a href="/admin/produits/{{ produit.id }}/modifier">Modifier</a>

            <form method="POST" action="/admin/produits/{{ produit.id }}/supprimer" style="display:inline;">
              {{ csrfField() }}
              <button type="submit" onclick="return confirm('Supprimer ce produit ?')">Supprimer</button>
            </form>
          </td>
        </tr>
      @end
    </tbody>
  </table>
</body>
</html>

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Nouveau produit</title>
</head>
<body>
  <h1>Nouveau produit</h1>
  @include('admin/_nav')

  @if(flashMessages.has('erreursValidation'))
    <ul style="color: red;">
      @each(erreur in flashMessages.get('erreursValidation'))
        <li>{{ erreur.message }}</li>
      @end
    </ul>
  @end

  <form method="POST" action="/admin/produits" enctype="multipart/form-data">
    {{ csrfField() }}
    <label for="nom">Nom</label>
    <input type="text" name="nom" id="nom" value="{{ old('nom', '') }}" required>

    <label for="description">Description</label>
    <textarea name="description" id="description">{{ old('description', '') }}</textarea>

    <label for="prix">Prix</label>
    <input type="number" step="0.01" name="prix" id="prix" value="{{ old('prix', '') }}" required>

    <label for="categorieId">Catégorie</label>
    <select name="categorieId" id="categorieId">
      @each(categorie in categories)
        <option value="{{ categorie.id }}" {{ old('categorieId') == categorie.id ? 'selected' : '' }}>
          {{ categorie.nom }}
        </option>
      @end
    </select>

    <label for="image">Image</label>
    <input type="file" name="image" id="image" accept="image/*">

    <label for="disponible">Disponible</label>
    <input type="checkbox" name="disponible" id="disponible" checked>

    <button type="submit">Créer</button>
  </form>
</body>
</html>
